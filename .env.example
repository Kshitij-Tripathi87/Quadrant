# Application Configuration
APP_NAME="Technical Documentation RAG Assistant"
APP_ENV="development"
PORT=8000
HOST="0.0.0.0"

# LLM Provider Configuration
# Supported: "gemini" | "groq" | "openai"
DEFAULT_LLM_PROVIDER="gemini"

# API Keys (Set the one for your selected provider)
GEMINI_API_KEY="your-gemini-api-key"

OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

# Model Names
GEMINI_MODEL="gemini-3.5-flash-lite"


# Embedding Provider
# Options: "fastembed" | "huggingface" | "openai"
# (fastembed and huggingface run 100% locally with zero external API costs)
EMBEDDING_PROVIDER="fastembed"
EMBEDDING_MODEL="sentence-transformers/all-MiniLM-L6-v2"

# Search Fallback Provider: "duckduckgo" | "tavily"
SEARCH_PROVIDER="duckduckgo"
TAVILY_API_KEY=""

# Self-Correction Parameters
TOP_K_RETRIEVAL=4
MAX_RETRIES=2

# Paths
CHROMA_PERSIST_DIRECTORY="./data/chroma_db"
SQLITE_DB_PATH="./data/app_storage.db"
DOCS_DIRECTORY="./data/raw_documents"
