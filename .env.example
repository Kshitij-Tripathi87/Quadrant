# Application Configuration
APP_NAME="Technical Documentation RAG Assistant"
APP_ENV="development"
PORT=8000
HOST="0.0.0.0"

# LLM Provider Configuration
# Supported: "groq" | "openai" | "gemini"
DEFAULT_LLM_PROVIDER="groq"

# API Keys (Set the one for your selected provider)
GROQ_API_KEY=""
OPENAI_API_KEY=""
GEMINI_API_KEY=""
ANTHROPIC_API_KEY=""

# Model Names
GROQ_MODEL="llama-3.3-70b-versatile"
OPENAI_MODEL="gpt-4o-mini"
GEMINI_MODEL="gemini-1.5-flash"

# Embedding Provider
# Options: "fastembed" | "huggingface" | "openai"
# (fastembed and huggingface run 100% locally with zero external API costs)
EMBEDDING_PROVIDER="fastembed"
EMBEDDING_MODEL="sentence-transformers/all-MiniLM-L6-v2"

# Search Fallback Provider: "duckduckgo" | "tavily"
SEARCH_PROVIDER="duckduckgo"
TAVILY_API_KEY=""

# Self-Correction Parameters
TOP_K_RETRIEVAL=4
MAX_RETRIES=2

# Paths
CHROMA_PERSIST_DIRECTORY="./data/chroma_db"
SQLITE_DB_PATH="./data/app_storage.db"
DOCS_DIRECTORY="./data/raw_documents"
